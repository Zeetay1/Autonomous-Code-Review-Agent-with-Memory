# Copy to .env and fill in what you need. All optional -- the dashboard, /api/reviews,
# and /api/stats work with none of this set. See README.md for what each one unlocks.

# --- GitHub (needed for real PR review via /webhook) ---
# Personal access token: repo scope (classic) or fine-grained with
# Contents: read, Pull requests: read/write on the target repo(s).
GITHUB_TOKEN=

# Any random string. If set, GitHub must sign webhook payloads with it
# (HMAC-SHA256) or requests are rejected with 401. Recommended once you register
# a real webhook (see README).
GITHUB_WEBHOOK_SECRET=

# --- LLM provider (needed for /webhook and /api/try) ---
# Pick ONE. Leave LLM_PROVIDER unset (or "anthropic") + set ANTHROPIC_API_KEY to use
# Claude -- OR set LLM_PROVIDER=groq + GROQ_API_KEY to use Groq instead.
LLM_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GROQ_API_KEY=
GROQ_MODEL=

# --- Demo ---
# Populate the dashboard with a realistic sample PR review at startup (no LLM call).
# See scripts/seed_demo_data.py for the local-dev equivalent.
SEED_DEMO_DATA=
